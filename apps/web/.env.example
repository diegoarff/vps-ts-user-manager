USERS_DB_PATH=./data/dev-users_database.yml
BACKUPS_DIR=./data/backups
AUTHELIA_URL=http://localhost:9091
DOCKER_SOCKET=/var/run/docker.sock

# Comma-separated domains the app cannot classify from the Docker socket
# alone. Tailnet-only domains resolve to the tailnet IP (DNS-only, not
# public); anything not listed here defaults to public.
SERVICES_TAILNET_DOMAINS=
SERVICES_AUTHELIA_DOMAINS=
